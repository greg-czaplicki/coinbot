COPY_SOURCE_WALLET=0x1d0034134e339a309700ff2d34e99fa2d48b0313
COPY_MODE=intent_net
COPY_COALESCE_MS=50
COPY_NET_OPPOSITE_TRADES=true
COPY_SOURCE_ACTIVITY_ENABLED=true
COPY_SOURCE_WS_ENABLED=false
COPY_SOURCE_WS_MODE=market
COPY_SOURCE_ACTIVITY_WS_URL=wss://ws-live-data.polymarket.com
COPY_SOURCE_ACTIVITY_POLL_INTERVAL_MS=350
COPY_SOURCE_ACTIVITY_HTTP_TIMEOUT_MS=2500
COPY_MAX_SOURCE_STALENESS_MS=4000
LOG_PROFILE=verbose
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com

SIZING_MODE=capped_proportional
SIZING_FIXED_ORDER_NOTIONAL_USD=1
SIZING_SIZE_MULTIPLIER=0.35
SIZING_MIN_ORDER_NOTIONAL_USD=3
SIZING_MAX_NOTIONAL_PER_ORDER_USD=5
SIZING_MAX_NOTIONAL_PER_MARKET_USD=25
SIZING_MAX_DAILY_TRADED_VOLUME_USD=2500
SIZING_MAX_TOTAL_NOTIONAL_PER_15M_WINDOW_USD=75

EXECUTION_ORDER_TYPE=marketable_limit
EXECUTION_MAX_SLIPPAGE_BPS=60
EXECUTION_NEAR_EXPIRY_CUTOFF_SECONDS=8
EXECUTION_FEE_BPS=10
EXECUTION_SAFETY_PROFILE=conservative
EXECUTION_DRY_RUN=true

# Polymarket credentials (keep secret)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=1

REDEEM_ENABLED=false
REDEEM_INTERVAL_SECONDS=60
# Defaults to POLYMARKET_FUNDER when unset.
REDEEM_WALLET_ADDRESS=
REDEEM_MIN_REDEEMABLE_SHARES=0.001
